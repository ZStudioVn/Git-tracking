// Prisma schema — Git-Tracking
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth.js ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  repositories Repository[]
  gitConfigs   GitConfig[]
  localProjects LocalProject[]
  systemLogs   SystemLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  // access_token stored encrypted at rest (SETUP.md §9, D-03)
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Repository ───────────────────────────────────────────────────────────────

model Repository {
  id          String   @id @default(cuid())
  userId      String
  githubId    Int      @unique
  owner       String
  name        String
  fullName    String   @unique // "owner/name"
  private     Boolean  @default(false)
  description String?
  defaultBranch String @default("main")
  cloneUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branches    Branch[]
  tags        Tag[]
  commits     Commit[]
  pullRequests PullRequest[]
  syncJobs    SyncJob[]
  syncCursors SyncCursor[]
  webhookDeliveries WebhookDelivery[]
  systemLogs SystemLog[]
  gitConfigs    GitConfig[]
  localProjects LocalProject[]
}

model GitConfig {
  id              String      @id @default(cuid())
  scopeKey         String      @unique
  userId          String
  repositoryId    String?
  authorName      String
  authorEmail     String
  defaultBranch   String?
  commitTemplate  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model LocalProject {
  id           String   @id @default(cuid())
  userId       String
  repositoryId String?
  name         String
  rootPath     String
  remoteUrl    String?
  branch       String?
  headSha      String?
  ahead        Int?
  behind       Int?
  changes      String[] @default([])
  isGitRepo    Boolean  @default(false)
  tracking     Boolean  @default(true)
  lastStatusAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@unique([userId, rootPath])
  @@index([userId, repositoryId])
}

// ─── Branch / Tag ─────────────────────────────────────────────────────────────

model Branch {
  id           String   @id @default(cuid())
  repositoryId String
  name         String
  headSha      String
  isDefault    Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  commits    BranchCommit[]

  @@unique([repositoryId, name])
}

model Tag {
  id           String   @id @default(cuid())
  repositoryId String
  name         String
  commitSha    String
  createdAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
}

// ─── Commit (DAG) ─────────────────────────────────────────────────────────────

model Commit {
  id           String   @id @default(cuid())
  repositoryId String
  sha          String
  message      String   @db.Text
  authorName   String
  authorEmail  String
  authoredAt   DateTime
  committedAt  DateTime
  url          String?
  createdAt    DateTime @default(now())

  repository Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  parents    CommitParent[] @relation("CommitParents")
  children   CommitParent[] @relation("CommitChildren")
  files      CommitFile[]
  branches   BranchCommit[]

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
}

model BranchCommit {
  branchId String
  commitId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  commit   Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@id([branchId, commitId])
  @@index([commitId])
}

model CommitParent {
  commitId String
  parentId String

  commit Commit @relation("CommitChildren", fields: [commitId], references: [id], onDelete: Cascade)
  parent Commit @relation("CommitParents", fields: [parentId], references: [id], onDelete: Cascade)

  @@id([commitId, parentId])
}

// CommitFile: store changed-file list + stats only — no full diff (D-04)
model CommitFile {
  id        String     @id @default(cuid())
  commitId  String
  path      String
  oldPath   String?    // for renames
  status    FileStatus
  additions Int        @default(0)
  deletions Int        @default(0)
  binary    Boolean    @default(false)

  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@index([commitId])
}

enum FileStatus {
  ADDED
  MODIFIED
  DELETED
  RENAMED
  COPIED
  UNCHANGED
}

// ─── Pull Request ─────────────────────────────────────────────────────────────

model PullRequest {
  id           String          @id @default(cuid())
  repositoryId String
  githubId     Int
  number       Int
  title        String          @db.Text
  state        PullRequestState
  headSha      String?
  baseBranch   String
  headBranch   String
  authorLogin  String?
  url          String?
  mergedAt     DateTime?
  closedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

// ─── Sync Job (plain cron for MVP — D-01; upgraded to BullMQ in Phase 4) ─────

model SyncJob {
  id           String       @id @default(cuid())
  repositoryId String
  status       SyncJobStatus @default(PENDING)
  type         SyncJobType   @default(FULL)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?       @db.Text
  retryCount   Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  availableAt  DateTime       @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, status])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  deliveryId   String
  repositoryId String?
  event        String
  action       String?
  receivedAt   DateTime @default(now())

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId])
  @@index([repositoryId, receivedAt])
}

model SystemLog {
  id           String        @id @default(cuid())
  userId       String?
  repositoryId String?
  level        SystemLogLevel
  category     String
  message      String        @db.Text
  context      Json?
  requestId    String?
  createdAt    DateTime      @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([repositoryId, createdAt])
  @@index([level, createdAt])
  @@index([category, createdAt])
}

enum SystemLogLevel {
  INFO
  WARN
  ERROR
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  STALE       // auth revoked (SETUP.md §9)
}

enum SyncJobType {
  FULL
  INCREMENTAL
  WEBHOOK
}

// ─── Sync Cursor (incremental sync — D-05) ───────────────────────────────────

model SyncCursor {
  id           String   @id @default(cuid())
  repositoryId String
  branchName   String
  lastSyncedSha String
  syncedAt     DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, branchName])
}
