{
  "name": "git-tracking",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "electron:typecheck": "tsc --noEmit -p electron/tsconfig.json",
    "desktop:compile": "tsc -p electron/tsconfig.json",
    "desktop:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "next build && npm run desktop:compile",
    "desktop:package": "npm run desktop:build && electron-builder",
    "desktop:win": "npm run desktop:build && electron-builder --win",
    "desktop:mac": "npm run desktop:build && electron-builder --mac",
    "desktop:linux": "npm run desktop:build && electron-builder --linux"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0",
    "@octokit/rest": "^21.0.0",
    "isomorphic-git": "^1.27.0",
    "next-auth": "5.0.0-beta.22",
    "@auth/prisma-adapter": "^2.6.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "@visx/visx": "^3.10.0",
    "@visx/shape": "^3.3.0",
    "@visx/scale": "^3.3.0",
    "@visx/group": "^3.3.0",
    "react-diff-view": "^3.2.1",
    "diff": "^5.1.0",
    "sonner": "^1.3.1",
    "swr": "^2.2.4",
    "zod": "^3.22.4",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/diff": "^5.0.9",
    "typescript": "^5.6.0",
    "eslint": "^8",
    "eslint-config-next": "^14.2.0",
    "@faker-js/faker": "^9.2.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^3.4.0",
    "postcss": "^8",
    "autoprefixer": "^10",
    "tsx": "^4.19.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "concurrently": "^9.1.0",
    "chokidar": "^4.0.1",
    "electron-store": "^10.0.0",
    "wait-on": "^8.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
