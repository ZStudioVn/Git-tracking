# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gittracking"

# ─── NextAuth.js ──────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── GitHub OAuth App (D-03: OAuth App for MVP, upgrade to GitHub App in Phase 5)
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"

# ─── Token encryption (SETUP.md §9: AES-256-GCM)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-32-byte-base64-encoded-encryption-key"

# ─── Sync / Polling
# Cron interval in minutes (D-01: plain cron for MVP)
SYNC_POLL_INTERVAL_MINUTES="15"

# ─── Redis (Phase 4 BullMQ production worker; optional for DB-backed MVP)
# REDIS_URL="redis://localhost:6379"

# ─── Logging (pino)
LOG_LEVEL="info"
